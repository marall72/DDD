        "additionalProperties": false
      },
      "FilterOperator": {
        "enum": [
          "Equal",
          "NotEqual",
          "Contains",
          "StartsWith",
          "EndsWith",
          "GreaterThan",
          "LessThan",
          "GreaterOrEqual",
          "LessOrEqual",
          "In"
        ],
        "type": "string"
      }
    }
  },
  "tags": [
    {
      "name": "Product"
